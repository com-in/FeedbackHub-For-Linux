#!/usr/bin/env python3
"""反馈中心启动脚本。"""
import os
import sys

# 支持从源码目录（未安装）直接运行
_THIS = os.path.dirname(os.path.abspath(__file__))
_SRC = os.path.join(_THIS, "..", "feedbackhub")
if os.path.isdir(_SRC) and _SRC not in sys.path:
    sys.path.insert(0, os.path.join(_THIS, ".."))

from feedbackhub.app import run  # noqa: E402

if __name__ == "__main__":
    sys.exit(run())